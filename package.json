{
  "name": "launchbridge",
  "version": "1.1.0",
  "description": "CLI tool to install LaunchBridge skills into target repositories",
  "private": true,
  "type": "module",
  "bin": {
    "launchbridge": "./install_script/index.js"
  },
  "files": [
    "install_script/index.js",
    "install_script/lib/",
    "install_script/package.json",
    "install_script/package-lock.json",
    "skills/"
  ],
  "scripts": {
    "setup": "git submodule update --init && unset npm_config_allow_scripts && cd install_script && npm ci && cd .. && npm link"
  },
  "dependencies": {
    "inquirer": "^14.2.5"
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "keywords": [
    "cli",
    "skills",
    "iris",
    "kiro",
    "claude"
  ],
  "license": "MIT-0"
}
