{
  "name": "launchbridge",
  "version": "1.2.0",
  "description": "CLI tool to install LaunchBridge skills into target repositories",
  "private": true,
  "type": "module",
  "bin": {
    "launchbridge": "./install_script/index.js"
  },
  "files": [
    "install_script/index.js",
    "install_script/lib/"
  ],
  "scripts": {
    "setup": "git submodule update --init && unset npm_config_allow_scripts && npm ci && npm link",
    "start": "node install_script/index.js",
    "test": "vitest --run --config install_script/vitest.config.js",
    "test:watch": "vitest --config install_script/vitest.config.js",
    "format": "prettier --write \"install_script/**/*.js\"",
    "format:check": "prettier --check \"install_script/**/*.js\""
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "inquirer": "^14.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.3",
    "prettier": "3.9.10",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "keywords": [
    "cli",
    "skills",
    "iris",
    "kiro",
    "claude"
  ],
  "license": "MIT-0"
}
